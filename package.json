{
  "name": "zero",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "file-engine:prepare": "node scripts/prepare-file-engine.mjs",
    "file-engine:build": "pnpm file-engine:prepare && vite build --config vite.file-engine.config.ts",
    "file-engine:package": "node scripts/package-file-engine.mjs",
    "predev": "pnpm file-engine:prepare",
    "dev": "vite",
    "prebuild": "pnpm file-engine:prepare",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:prepare": "node scripts/prepare-test-fixtures.mjs",
    "test:unit": "pnpm test:prepare && node scripts/run-tests.mjs unit",
    "test:integration": "pnpm test:prepare && node scripts/run-tests.mjs integration",
    "test": "pnpm test:prepare && node scripts/run-tests.mjs all",
    "icons:validate": "node scripts/icon-system.mjs validate",
    "icons:contact-sheet": "node scripts/icon-system.mjs contact-sheet",
    "icons:generate-tray": "node scripts/icon-system.mjs generate-tray",
    "icons:generate-app": "node scripts/icon-system.mjs generate-app",
    "test:icons": "node --test tests/integration/sourceContracts/iconSystem.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "docx": "9.7.1",
    "docx-preview": "0.4.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jszip": "3.10.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
